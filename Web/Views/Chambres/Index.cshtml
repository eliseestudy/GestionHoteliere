@model IEnumerable<Web.Models.ChambreListItemViewModel>
@{ ViewData["Title"] = "Chambres"; var rows = Model.ToList(); }
<div class="page-heading"><div><span class="page-eyebrow">Hébergement</span><h1>Chambres</h1></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouvelle chambre</a></div>
<div class="crud-toolbar">
    <div><label for="roomSearch">Rechercher</label><input id="roomSearch" class="form-control" data-table="#roomsTable" data-dt-search placeholder="N°, observation…" /></div>
    <div><label for="roomStatus">Statut</label><select id="roomStatus" class="form-select" data-table="#roomsTable" data-column-filter data-column="3"><option value="">Tous</option>@foreach (var value in rows.Select(x => x.Chambre.Statut.ToString()).Distinct().OrderBy(x => x)) { <option value="@value">@value</option> }</select></div>
    <div><label for="roomType">Type</label><select id="roomType" class="form-select" data-table="#roomsTable" data-column-filter data-column="2"><option value="">Tous</option>@foreach (var value in rows.Select(x => x.Chambre.TypeChambre?.Libelle).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x)) { <option value="@value">@value</option> }</select></div>
    <div><label for="roomFloor">Étage</label><div class="d-flex gap-2"><select id="roomFloor" class="form-select" data-table="#roomsTable" data-column-filter data-column="1"><option value="">Tous</option>@foreach (var value in rows.Select(x => x.Chambre.Etage).Distinct().OrderBy(x => x)) { <option value="@value">@value</option> }</select><button class="btn btn-outline-secondary" type="button" data-reset-table="#roomsTable"><i class="bi bi-arrow-counterclockwise"></i></button></div></div>
</div>
<div class="crud-table-card"><table id="roomsTable" class="table table-hover align-middle js-data-table" data-order='[[0,"asc"]]'><thead><tr><th>N° chambre</th><th>Étage</th><th>Type de chambre</th><th>Statut</th><th>Lits</th><th>Observations</th><th class="all no-sort text-end">Actions</th></tr></thead><tbody>
@foreach (var item in rows) { var c = item.Chambre; <tr><td class="fw-semibold">@c.Numero</td><td>@c.Etage</td><td>@c.TypeChambre?.Libelle</td><td><span class="badge text-bg-secondary">@c.Statut</span></td><td>@c.NbLits</td><td>@c.Observations</td><td><div class="table-actions"><a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-success" title="Voir" data-bs-toggle="tooltip"><i class="bi bi-eye"></i></a><div class="dropdown"><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown" aria-label="Actions"><i class="bi bi-three-dots-vertical"></i></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-action="Edit" asp-route-id="@c.Id"><i class="bi bi-pencil"></i> Modifier</a></li>@if(item.CanSetCleaning){<li><button class="dropdown-item js-confirm-action" data-post-url="@Url.Action("SetState", new { id=c.Id, statut=ChambreStatut.Nettoyage })" data-confirm-title="Passer en nettoyage" data-confirm-message="Marquer cette chambre en nettoyage ?" data-confirm-class="btn-primary"><i class="bi bi-stars"></i> Nettoyage</button></li>}@if(item.CanSetMaintenance){<li><button class="dropdown-item js-confirm-action" data-post-url="@Url.Action("SetState", new { id=c.Id, statut=ChambreStatut.Maintenance })" data-confirm-title="Maintenance" data-confirm-message="Mettre cette chambre en maintenance ?"><i class="bi bi-tools"></i> Maintenance</button></li>}@if(item.CanSetOutOfService){<li><button class="dropdown-item js-confirm-action" data-post-url="@Url.Action("SetState", new { id=c.Id, statut=ChambreStatut.HorsService })" data-confirm-title="Hors service" data-confirm-message="Mettre cette chambre hors service ?"><i class="bi bi-slash-circle"></i> Hors service</button></li>}@if(item.CanSetReady){<li><button class="dropdown-item js-confirm-action" data-post-url="@Url.Action("SetState", new { id=c.Id, statut=ChambreStatut.Libre })" data-confirm-title="Marquer prête" data-confirm-message="Marquer cette chambre prête ?" data-confirm-class="btn-primary"><i class="bi bi-check-circle"></i> Marquer prête</button></li>}@if(item.CanDelete){<li><hr class="dropdown-divider" /></li><li><button class="dropdown-item text-danger js-confirm-action" data-post-url="@Url.Action("DeleteConfirmed", new { id=c.Id })" data-confirm-title="Supprimer la chambre" data-confirm-message="Supprimer cette chambre ?"><i class="bi bi-trash"></i> Supprimer</button></li>}</ul></div></div></td></tr> }
</tbody></table></div>
