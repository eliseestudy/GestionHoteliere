@model IEnumerable<GestionHoteliere.Domain.Entities.User>
@{ ViewData["Title"]="Utilisateurs";var rows=Model.ToList(); }
<div class="page-heading"><div><span class="page-eyebrow">Administration</span><h1>Utilisateurs</h1></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Nouvel utilisateur</a></div>
<div class="crud-toolbar"><div><label for="userSearch">Rechercher</label><input id="userSearch" class="form-control" data-table="#usersTable" data-dt-search placeholder="Nom, identifiant, email…" /></div><div><label for="userRole">Rôle</label><select id="userRole" class="form-select" data-table="#usersTable" data-column-filter data-column="2"><option value="">Tous</option>@foreach(var value in rows.Select(x=>x.Role.ToString()).Distinct().OrderBy(x=>x)){<option value="@value">@value</option>}</select></div><div><label for="userActive">État du compte</label><select id="userActive" class="form-select" data-table="#usersTable" data-column-filter data-column="5"><option value="">Tous</option><option value="Actif">Actif</option><option value="Inactif">Inactif</option></select></div><div class="crud-toolbar-actions"><button class="btn btn-outline-secondary" type="button" data-reset-table="#usersTable"><i class="bi bi-arrow-counterclockwise"></i> Réinitialiser</button></div></div>
<div class="crud-table-card"><table id="usersTable" class="table table-hover align-middle js-data-table" data-order='[[0,"asc"]]'><thead><tr><th>Nom d’utilisateur</th><th>Email</th><th>Rôle</th><th>Prénom</th><th>Nom</th><th>Compte</th><th class="all no-sort text-end">Actions</th></tr></thead><tbody>@foreach(var u in rows){<tr><td class="fw-semibold">@u.Username</td><td>@u.Email</td><td>@u.Role</td><td>@u.Prenom</td><td>@u.Nom</td><td><span class="badge @(u.IsActive ? "text-bg-success" : "text-bg-secondary")">@(u.IsActive ? "Actif" : "Inactif")</span></td><td><div class="table-actions"><a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-success" title="Voir" data-bs-toggle="tooltip"><i class="bi bi-eye"></i></a><a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" title="Modifier" data-bs-toggle="tooltip"><i class="bi bi-pencil"></i></a><button class="btn btn-sm btn-outline-warning js-confirm-action" data-post-url="@Url.Action("ToggleActive",new{id=u.Id})" data-confirm-title="Changer l’accès" data-confirm-message="@(u.IsActive ? "Désactiver cet utilisateur ?" : "Activer cet utilisateur ?")" data-confirm-class="btn-warning" title="@(u.IsActive ? "Désactiver" : "Activer")" data-bs-toggle="tooltip"><i class="bi @(u.IsActive ? "bi-person-dash" : "bi-person-check")"></i></button><button class="btn btn-sm btn-outline-danger js-confirm-action" data-post-url="@Url.Action("Delete",new{id=u.Id})" data-confirm-title="Supprimer l’utilisateur" data-confirm-message="Supprimer cet utilisateur s’il n’a aucun paiement associé ?" title="Supprimer" data-bs-toggle="tooltip"><i class="bi bi-trash"></i></button></div></td></tr>}</tbody></table></div>
