@model GestionHoteliere.Domain.Entities.Paiement

@{
    ViewData["Title"] = "Supprimer un paiement";
}

<h1>Supprimer un paiement</h1>

<h3>Confirmez la suppression de cet element.</h3>
<div>
    <h4>Informations du paiement</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Facture)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Facture!.NumeroFacture)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DatePaiement)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DatePaiement)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Montant)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Montant)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Mode)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Mode)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Statut)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Statut)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TransactionReference)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TransactionReference)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.User)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.User!.Username)
        </dd>
        <!-- Métadonnées masquées -->
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirmer la suppression" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Retour à la liste</a>
    </form>
</div>
