@model IEnumerable<Web.Models.PaiementListItemViewModel>
@{ ViewData["Title"] = "Paiements"; var rows=Model.ToList(); }
<div class="page-heading"><div><span class="page-eyebrow">Finance</span><h1>Registre des paiements</h1><p>Les paiements sont enregistrés depuis les factures éligibles.</p></div></div>
<div class="crud-toolbar">
    <div><label for="paymentSearch">Rechercher</label><input id="paymentSearch" class="form-control" data-table="#paymentsTable" data-dt-search placeholder="Facture, référence…" /></div>
    <div><label for="paymentStatus">Statut</label><select id="paymentStatus" class="form-select" data-table="#paymentsTable" data-column-filter data-column="4"><option value="">Tous</option>@foreach(var value in rows.Select(x=>x.Paiement.Statut.ToString()).Distinct().OrderBy(x=>x)){<option value="@value">@value</option>}</select></div>
    <div><label for="paymentMode">Mode</label><select id="paymentMode" class="form-select" data-table="#paymentsTable" data-column-filter data-column="3"><option value="">Tous</option>@foreach(var value in rows.Select(x=>x.Paiement.Mode.ToString()).Distinct().OrderBy(x=>x)){<option value="@value">@value</option>}</select></div>
    <div><label>Période de paiement</label><div class="d-flex gap-2"><input id="paymentDateMin" type="date" class="form-control" data-table="#paymentsTable" data-filter-type="date-min" data-column="1" /><input id="paymentDateMax" type="date" class="form-control" data-table="#paymentsTable" data-filter-type="date-max" data-column="1" /><button class="btn btn-outline-secondary" type="button" data-reset-table="#paymentsTable"><i class="bi bi-arrow-counterclockwise"></i></button></div></div>
</div>
<div class="crud-table-card"><table id="paymentsTable" class="table table-hover align-middle js-data-table" data-order='[[1,"desc"]]'><thead><tr><th>N° facture</th><th>Date de paiement</th><th class="text-end">Montant</th><th>Mode</th><th>Statut</th><th>Référence</th><th class="all no-sort text-end">Actions</th></tr></thead><tbody>@foreach(var item in rows){var p=item.Paiement;<tr><td>@p.Facture?.NumeroFacture</td><td data-filter="@p.DatePaiement.ToString("yyyy-MM-dd")" data-order="@p.DatePaiement.ToUnixTimeSeconds()">@p.DatePaiement.ToString("dd/MM/yyyy")</td><td class="text-end" data-order="@p.Montant">@p.Montant.ToString("N0") FCFA</td><td>@p.Mode</td><td><span class="badge text-bg-secondary">@p.Statut</span></td><td>@p.TransactionReference</td><td><div class="table-actions"><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-success" title="Voir" data-bs-toggle="tooltip"><i class="bi bi-eye"></i></a>@if(item.CanRefund){<button class="btn btn-sm btn-outline-danger js-confirm-action" data-post-url="@Url.Action("Refund",new{id=p.Id})" data-confirm-title="Remboursement total" data-confirm-message="Rembourser totalement ce paiement ?" title="Rembourser" data-bs-toggle="tooltip"><i class="bi bi-arrow-counterclockwise"></i></button>}</div></td></tr>}</tbody></table></div>
