@model IEnumerable<GestionHoteliere.Domain.Entities.TypeChambre>
@{ ViewData["Title"]="Types de chambres";var rows=Model.ToList(); }
<div class="page-heading"><div><span class="page-eyebrow">Référentiel</span><h1>Types de chambres</h1></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouveau type</a></div>
<div class="crud-toolbar"><div><label for="typeSearch">Rechercher</label><input id="typeSearch" class="form-control" data-table="#roomTypesTable" data-dt-search placeholder="Libellé, description…" /></div><div><label>Capacité</label><div class="d-flex gap-2"><input id="typeCapacityMin" type="number" min="1" class="form-control" data-table="#roomTypesTable" data-filter-type="number-min" data-column="2" placeholder="Min." /><input id="typeCapacityMax" type="number" min="1" class="form-control" data-table="#roomTypesTable" data-filter-type="number-max" data-column="2" placeholder="Max." /></div></div><div><label>Prix par nuit</label><div class="d-flex gap-2"><input id="typePriceMin" type="number" min="0" class="form-control" data-table="#roomTypesTable" data-filter-type="number-min" data-column="3" placeholder="Min." /><input id="typePriceMax" type="number" min="0" class="form-control" data-table="#roomTypesTable" data-filter-type="number-max" data-column="3" placeholder="Max." /></div></div><div class="crud-toolbar-actions"><button class="btn btn-outline-secondary" type="button" data-reset-table="#roomTypesTable"><i class="bi bi-arrow-counterclockwise"></i> Réinitialiser</button></div></div>
<div class="crud-table-card"><table id="roomTypesTable" class="table table-hover align-middle js-data-table" data-order='[[0,"asc"]]'><thead><tr><th>Libellé</th><th>Description</th><th>Capacité maximale</th><th class="text-end">Prix par nuit</th><th class="all no-sort text-end">Actions</th></tr></thead><tbody>@foreach(var t in rows){<tr><td class="fw-semibold">@t.Libelle</td><td>@t.Description</td><td data-filter="@t.Capacite">@t.Capacite</td><td class="text-end" data-filter="@t.PrixParNuit" data-order="@t.PrixParNuit">@t.PrixParNuit.ToString("N0") FCFA</td><td><div class="table-actions"><a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-success" title="Voir" data-bs-toggle="tooltip"><i class="bi bi-eye"></i></a><a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary" title="Modifier" data-bs-toggle="tooltip"><i class="bi bi-pencil"></i></a><a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger" title="Supprimer" data-bs-toggle="tooltip"><i class="bi bi-trash"></i></a></div></td></tr>}</tbody></table></div>
