@model GestionHoteliere.Domain.Entities.TypeChambre

@{
    ViewData["Title"] = "Modifier le type de chambre";
}

<h1>Modifier le type de chambre</h1>

<h4>Paramètres du type de chambre</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Libelle" class="form-label"></label>
                <input asp-for="Libelle" class="form-control" />
                <span asp-validation-for="Libelle" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Capacite" class="form-label"></label>
                <input asp-for="Capacite" class="form-control" />
                <span asp-validation-for="Capacite" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PrixParNuit" class="form-label"></label>
                <input asp-for="PrixParNuit" class="form-control" />
                <span asp-validation-for="PrixParNuit" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Id" />
            <!-- Champs de metadonnees supprimes (geres cote serveur) -->
            <div class="mb-3">
                <input type="submit" value="Enregistrer les modifications" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-outline-secondary">Retour à la liste</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
