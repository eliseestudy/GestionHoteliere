@model IEnumerable<Web.Models.FactureListItemViewModel>
@{ ViewData["Title"] = "Factures"; var rows = Model.ToList(); }
<div class="page-heading"><div><span class="page-eyebrow">Finance</span><h1>Factures</h1></div><a asp-action="Create" class="btn btn-outline-primary"><i class="bi bi-file-earmark-plus"></i> Facture hors séjour</a></div>
<div class="crud-toolbar">
    <div><label for="invoiceSearch">Rechercher</label><input id="invoiceSearch" class="form-control" data-table="#invoicesTable" data-dt-search placeholder="N°, client, séjour…" /></div>
    <div><label for="invoiceStatus">Statut</label><select id="invoiceStatus" class="form-select" data-table="#invoicesTable" data-column-filter data-column="8"><option value="">Tous</option>@foreach(var value in rows.Select(x=>x.Facture.Statut.ToString()).Distinct().OrderBy(x=>x)){<option value="@value">@value</option>}</select></div>
    <div><label for="invoiceClient">Client</label><select id="invoiceClient" class="form-select" data-table="#invoicesTable" data-column-filter data-column="1"><option value="">Tous</option>@foreach(var value in rows.Select(x=>$"{x.Facture.Client?.Prenom} {x.Facture.Client?.Nom}".Trim()).Where(x=>x.Length>0).Distinct().OrderBy(x=>x)){<option value="@value">@value</option>}</select></div>
    <div><label>Période d’échéance</label><div class="d-flex gap-2"><input id="invoiceDueMin" type="date" class="form-control" data-table="#invoicesTable" data-filter-type="date-min" data-column="4" /><input id="invoiceDueMax" type="date" class="form-control" data-table="#invoicesTable" data-filter-type="date-max" data-column="4" /><button class="btn btn-outline-secondary" type="button" data-reset-table="#invoicesTable"><i class="bi bi-arrow-counterclockwise"></i></button></div></div>
</div>
<div class="crud-table-card"><table id="invoicesTable" class="table table-hover align-middle js-data-table" data-order='[[3,"desc"]]'><thead><tr><th>N° facture</th><th>Client</th><th>Séjour</th><th>Émission</th><th>Échéance</th><th class="text-end">Montant TTC</th><th class="text-end">Montant payé</th><th class="text-end">Solde restant</th><th>Statut</th><th class="all no-sort text-end">Actions</th></tr></thead><tbody>
@foreach(var item in rows){var f=item.Facture;var client=$"{f.Client?.Prenom} {f.Client?.Nom}".Trim();<tr><td class="fw-semibold">@f.NumeroFacture</td><td>@client</td><td>@(f.SejourId.HasValue ? $"Séjour #{f.SejourId}" : "Hors séjour")</td><td data-order="@f.DateEmission.ToUnixTimeSeconds()">@f.DateEmission.ToString("dd/MM/yyyy")</td><td data-filter="@(f.DateEcheance?.ToString("yyyy-MM-dd") ?? "")" data-order="@(f.DateEcheance?.ToUnixTimeSeconds() ?? 0)">@(f.DateEcheance?.ToString("dd/MM/yyyy") ?? "-")</td><td class="text-end" data-order="@f.MontantTTC">@f.MontantTTC.ToString("N0") FCFA</td><td class="text-end" data-order="@f.MontantPaye">@f.MontantPaye.ToString("N0") FCFA</td><td class="text-end" data-order="@item.Solde">@item.Solde.ToString("N0") FCFA</td><td><span class="badge text-bg-secondary">@f.Statut</span></td><td><div class="table-actions"><a asp-action="Details" asp-route-id="@f.Id" class="btn btn-sm btn-outline-success" title="Voir" data-bs-toggle="tooltip"><i class="bi bi-eye"></i></a>@if(item.CanPay){<button class="btn btn-sm btn-primary js-open-payment" data-payment-url="@Url.Action("CreateForFacture", "Paiements", new { factureId=f.Id })" title="Enregistrer un paiement" data-bs-toggle="tooltip"><i class="bi bi-credit-card"></i></button>}<div class="dropdown"><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button><ul class="dropdown-menu dropdown-menu-end">@if(item.CanEdit){<li><a class="dropdown-item" asp-action="Edit" asp-route-id="@f.Id"><i class="bi bi-pencil"></i> Modifier</a></li>}@if(item.CanEmit){<li><button class="dropdown-item js-confirm-action" data-post-url="@Url.Action("Emit",new{id=f.Id})" data-confirm-title="Émettre la facture" data-confirm-message="Émettre et verrouiller cette facture ?" data-confirm-class="btn-primary"><i class="bi bi-send"></i> Émettre</button></li>}@if(item.CanDispute){<li><button class="dropdown-item js-confirm-action" data-post-url="@Url.Action("Dispute",new{id=f.Id})" data-confirm-title="Mettre en litige" data-confirm-message="Mettre cette facture en litige ?"><i class="bi bi-exclamation-diamond"></i> Mettre en litige</button></li>}@if(item.CanResolveDispute){<li><button class="dropdown-item js-confirm-action" data-post-url="@Url.Action("ResolveDispute",new{id=f.Id})" data-confirm-title="Résoudre le litige" data-confirm-message="Résoudre ce litige ?" data-confirm-class="btn-primary"><i class="bi bi-check-circle"></i> Résoudre le litige</button></li>}@if(item.CanCancel){<li><button class="dropdown-item js-confirm-action" data-post-url="@Url.Action("Cancel",new{id=f.Id})" data-confirm-title="Annuler la facture" data-confirm-message="Annuler cette facture ?"><i class="bi bi-x-circle"></i> Annuler</button></li>}@if(item.CanDelete){<li><hr class="dropdown-divider" /></li><li><button class="dropdown-item text-danger js-confirm-action" data-post-url="@Url.Action("DeleteConfirmed",new{id=f.Id})" data-confirm-title="Supprimer la facture" data-confirm-message="Supprimer cette facture brouillon ?"><i class="bi bi-trash"></i> Supprimer</button></li>}</ul></div></div></td></tr>}
</tbody></table></div>
