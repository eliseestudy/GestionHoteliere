@model GestionHoteliere.Domain.Entities.Facture

@{
    ViewData["Title"] = "Supprimer une facture";
}

<h1>Supprimer une facture</h1>

<h3>Confirmez la suppression de cet element.</h3>
<div>
    <h4>Informations de facturation</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NumeroFacture)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NumeroFacture)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Sejour)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Sejour!.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Client)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Client!.Nom)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateEmission)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateEmission)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateEcheance)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateEcheance)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MontantHT)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MontantHT)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Taxe)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Taxe)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MontantTTC)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MontantTTC)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MontantPaye)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MontantPaye)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Statut)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Statut)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirmer la suppression" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Retour à la liste</a>
    </form>
</div>
