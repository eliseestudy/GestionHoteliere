@model IEnumerable<Web.Models.SejourListItemViewModel>
@{ ViewData["Title"] = "Séjours"; var rows = Model.ToList(); }
<div class="page-heading"><div><span class="page-eyebrow">Exploitation</span><h1>Séjours</h1></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Arrivée sans réservation</a></div>
<div class="crud-toolbar">
    <div><label for="staySearch">Rechercher</label><input id="staySearch" class="form-control" data-table="#staysTable" data-dt-search placeholder="Client, réservation…" /></div>
    <div><label for="stayStatus">Statut</label><select id="stayStatus" class="form-select" data-table="#staysTable" data-column-filter data-column="6"><option value="">Tous</option>@foreach(var value in rows.Select(x=>x.Sejour.Statut.ToString()).Distinct().OrderBy(x=>x)){<option value="@value">@value</option>}</select></div>
    <div><label for="stayRoom">Chambre</label><select id="stayRoom" class="form-select" data-table="#staysTable" data-column-filter data-column="2"><option value="">Toutes</option>@foreach(var value in rows.Select(x=>x.Sejour.Chambre?.Numero).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x=>x)){<option value="@value">@value</option>}</select></div>
    <div><label>Période d’entrée</label><div class="d-flex gap-2"><input id="stayDateMin" type="date" class="form-control" data-table="#staysTable" data-filter-type="date-min" data-column="3" /><input id="stayDateMax" type="date" class="form-control" data-table="#staysTable" data-filter-type="date-max" data-column="3" /><button class="btn btn-outline-secondary" type="button" data-reset-table="#staysTable"><i class="bi bi-arrow-counterclockwise"></i></button></div></div>
</div>
<div class="crud-table-card"><table id="staysTable" class="table table-hover align-middle js-data-table" data-order='[[3,"desc"]]'><thead><tr><th>N° réservation</th><th>Client</th><th>Chambre</th><th>Entrée</th><th>Sortie</th><th>Nuits</th><th>Statut</th><th class="all no-sort text-end">Actions</th></tr></thead><tbody>
@foreach(var item in rows){var s=item.Sejour;<tr><td>@(s.Reservation?.NumeroReservation ?? "Sans réservation")</td><td>@s.Client?.Prenom @s.Client?.Nom</td><td>@s.Chambre?.Numero</td><td data-filter="@s.DateEntree.ToString("yyyy-MM-dd")" data-order="@s.DateEntree.ToUnixTimeSeconds()">@s.DateEntree.ToString("dd/MM/yyyy")</td><td data-order="@(s.DateSortie?.ToUnixTimeSeconds() ?? 0)">@(s.DateSortie?.ToString("dd/MM/yyyy") ?? "-")</td><td>@s.NbNuits</td><td><span class="badge text-bg-secondary">@s.Statut</span></td><td><div class="table-actions"><a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-success" title="Voir" data-bs-toggle="tooltip"><i class="bi bi-eye"></i></a>@if(item.CanCheckout){<a asp-action="Checkout" asp-route-id="@s.Id" class="btn btn-sm btn-primary" title="Faire le check-out" data-bs-toggle="tooltip"><i class="bi bi-box-arrow-right"></i></a>}<div class="dropdown"><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-action="Edit" asp-route-id="@s.Id"><i class="bi bi-pencil"></i> Modifier</a></li>@if(item.CanCancel){<li><button class="dropdown-item text-danger js-confirm-action" data-post-url="@Url.Action("Cancel", new { id=s.Id })" data-confirm-title="Annuler le séjour" data-confirm-message="Annuler ce séjour ?"><i class="bi bi-x-circle"></i> Annuler</button></li>}</ul></div></div></td></tr>}
</tbody></table></div>
