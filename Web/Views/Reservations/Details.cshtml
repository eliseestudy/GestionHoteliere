@model GestionHoteliere.Domain.Entities.Reservation

@{
    ViewData["Title"] = "Fiche réservation";
}

<h1>Fiche réservation</h1>

<div>
    <h4>Informations de réservation</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NumeroReservation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NumeroReservation)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Client)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Client!.Nom)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Chambre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Chambre!.Numero)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TypeChambre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TypeChambre!.Libelle)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateCreation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateCreation)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateArrivee)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateArrivee)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateDepart)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateDepart)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Statut)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Statut)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NombrePersonnes)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NombrePersonnes)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MontantEstime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MontantEstime)
        </dd>
        <!-- Métadonnées masquées : gérées côté serveur -->
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Modifier</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Retour à la liste</a>
</div>
