@model IEnumerable<GestionHoteliere.Domain.Entities.Client>
@{ ViewData["Title"]="Clients";var rows=Model.ToList(); }
<div class="page-heading"><div><span class="page-eyebrow">Répertoire</span><h1>Clients</h1></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Nouveau client</a></div>
<div class="crud-toolbar"><div><label for="clientSearch">Identité ou contact</label><input id="clientSearch" class="form-control" data-table="#clientsTable" data-dt-search placeholder="Nom, email, téléphone…" /></div><div><label>Date de naissance, du</label><input id="clientBirthMin" type="date" class="form-control" data-table="#clientsTable" data-filter-type="date-min" data-column="5" /></div><div><label>Au</label><input id="clientBirthMax" type="date" class="form-control" data-table="#clientsTable" data-filter-type="date-max" data-column="5" /></div><div class="crud-toolbar-actions"><button class="btn btn-outline-secondary" type="button" data-reset-table="#clientsTable"><i class="bi bi-arrow-counterclockwise"></i> Réinitialiser</button></div></div>
<div class="crud-table-card"><table id="clientsTable" class="table table-hover align-middle js-data-table" data-order='[[1,"asc"],[0,"asc"]]'><thead><tr><th>Prénom</th><th>Nom</th><th>Email</th><th>Téléphone</th><th>Adresse</th><th>Date de naissance</th><th>N° pièce d’identité</th><th class="all no-sort text-end">Actions</th></tr></thead><tbody>@foreach(var c in rows){<tr><td>@c.Prenom</td><td class="fw-semibold">@c.Nom</td><td>@c.Email</td><td>@c.Telephone</td><td>@c.Adresse</td><td data-filter="@(c.DateNaissance?.ToString("yyyy-MM-dd") ?? "")" data-order="@(c.DateNaissance?.Ticks ?? 0)">@(c.DateNaissance?.ToString("dd/MM/yyyy") ?? "-")</td><td>@c.IdentifiantNational</td><td><div class="table-actions"><a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-success" title="Voir" data-bs-toggle="tooltip"><i class="bi bi-eye"></i></a><a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary" title="Modifier" data-bs-toggle="tooltip"><i class="bi bi-pencil"></i></a><a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger" title="Supprimer" data-bs-toggle="tooltip"><i class="bi bi-trash"></i></a></div></td></tr>}</tbody></table></div>
