{
  "version": "1.0",
  "defaultProvider": "unpkg",
  "libraries": [
    {
      "library": "bootstrap@5.3.8",
      "destination": "wwwroot/lib/bootstrap/",
      "files": [
        "dist/css/bootstrap.min.css",
        "dist/css/bootstrap.min.css.map",
        "dist/js/bootstrap.bundle.min.js",
        "dist/js/bootstrap.bundle.min.js.map",
        "LICENSE"
      ]
    },
    {
      "library": "bootstrap-icons@1.13.1",
      "destination": "wwwroot/lib/bootstrap-icons/",
      "files": [
        "font/bootstrap-icons.min.css",
        "font/fonts/bootstrap-icons.woff",
        "font/fonts/bootstrap-icons.woff2",
        "LICENSE"
      ]
    },
    {
      "library": "jquery@4.0.0",
      "destination": "wwwroot/lib/jquery/",
      "files": [
        "dist/jquery.min.js",
        "dist/jquery.min.map",
        "LICENSE.txt"
      ]
    },
    {
      "library": "jquery-validation@1.22.1",
      "destination": "wwwroot/lib/jquery-validation/",
      "files": [
        "dist/jquery.validate.min.js",
        "LICENSE.md"
      ]
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive/",
      "files": [
        "dist/jquery.validate.unobtrusive.min.js",
        "LICENSE.txt"
      ]
    },
    {
      "library": "datatables.net@2.3.8",
      "destination": "wwwroot/lib/datatables/",
      "files": [
        "js/dataTables.min.js",
        "License.txt"
      ]
    },
    {
      "library": "datatables.net-bs5@2.3.8",
      "destination": "wwwroot/lib/datatables-bs5/",
      "files": [
        "js/dataTables.bootstrap5.min.js",
        "css/dataTables.bootstrap5.min.css",
        "License.txt"
      ]
    },
    {
      "library": "datatables.net-responsive@3.0.8",
      "destination": "wwwroot/lib/datatables-responsive/",
      "files": [
        "js/dataTables.responsive.min.js",
        "License.txt"
      ]
    },
    {
      "library": "datatables.net-responsive-bs5@3.0.8",
      "destination": "wwwroot/lib/datatables-responsive-bs5/",
      "files": [
        "js/responsive.bootstrap5.min.js",
        "css/responsive.bootstrap5.min.css",
        "License.txt"
      ]
    }
  ]
}
